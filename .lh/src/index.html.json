            "date": 1787507810476,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\n<html>\n\n<head>\n\n  <meta charset=\"UTF-8\">\n\n  <meta\n    name=\"viewport\"\n    content=\"width=device-width, initial-scale=1, viewport-fit=cover\"\n  >\n\n  <title>CyberWrap</title>\n\n\n  <!-- =========================================================\n       CYBERWRAP STYLES\n  ========================================================= -->\n\n  <style>\n\n    /* =========================================================\n       GLOBAL\n    ========================================================= */\n\n    html,\n    body {\n      margin: 0;\n      padding: 0;\n\n      width: 100%;\n      height: 100%;\n\n      overflow: hidden;\n\n      background: #000;\n\n      -webkit-tap-highlight-color: transparent;\n    }\n\n\n    body {\n      user-select: none;\n      -webkit-user-select: none;\n      -webkit-touch-callout: none;\n    }\n\n\n    /* =========================================================\n       CYBERWRAP BOOT OPENER\n    ========================================================= */\n\n   #cyberwrap-opener {\n  position: fixed;\n  inset: 0;\n\n  width: 100vw;\n  height: 100dvh;\n\n  z-index: 2147483647;\n\n  background: #000;\n\n  opacity: 1;\n  visibility: visible;\n\n  pointer-events: auto;\n  touch-action: manipulation;\n\n  cursor: pointer;\n\n  overflow: hidden;\n\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-touch-callout: none;\n\n  -webkit-tap-highlight-color: transparent;\n\n  transition:\n    opacity 0.8s ease,\n    visibility 0.8s ease;\n}\n\n    /* =========================================================\n       HIDDEN OPENER\n    ========================================================= */\n\n    #cyberwrap-opener.hidden {\n  opacity: 0 !important;\n  visibility: hidden !important;\n  pointer-events: none !important;\n}\n\n\n    /* =========================================================\n       OPENER IMAGE\n    ========================================================= */\n\n    .opener-image {\n\n      position: absolute;\n\n      inset: -6%;\n\n      background-image:\n        url(\"/assets/cyberwrap-main-opener.webp\");\n\n      background-position: center center;\n\n      background-size: cover;\n\n      background-repeat: no-repeat;\n\n      transform-origin: center center;\n\n      animation:\n        opener-camera 4.5s ease-out forwards,\n        opener-drift 4.5s ease-in-out infinite;\n\n      will-change: transform;\n    }\n\n\n    /* =========================================================\n       CINEMATIC CAMERA PUSH\n    ========================================================= */\n\n    @keyframes opener-camera {\n\n      0% {\n        transform: scale(1.02);\n      }\n\n      100% {\n        transform: scale(1.13);\n      }\n\n    }\n\n\n    /* =========================================================\n       SUBTLE CAMERA DRIFT\n    ========================================================= */\n\n    @keyframes opener-drift {\n\n      0% {\n        translate: 0 0;\n      }\n\n      50% {\n        translate: -0.7% -0.4%;\n      }\n\n      100% {\n        translate: 0 0;\n      }\n\n    }\n\n\n    /* =========================================================\n       DIGITAL SCANLINES\n    ========================================================= */\n\n    .opener-scanlines {\n\n      position: absolute;\n\n      inset: 0;\n\n      background:\n        repeating-linear-gradient(\n          to bottom,\n\n          rgba(255, 255, 255, 0.025) 0px,\n\n          rgba(255, 255, 255, 0.025) 1px,\n\n          transparent 1px,\n\n          transparent 5px\n        );\n\n      animation:\n        scanline-move 1.8s linear infinite;\n\n      pointer-events: none;\n\n      mix-blend-mode: screen;\n    }\n\n\n    @keyframes scanline-move {\n\n      from {\n        background-position: 0 0;\n      }\n\n      to {\n        background-position: 0 80px;\n      }\n\n    }\n\n\n    /* =========================================================\n       CINEMATIC VIGNETTE\n    ========================================================= */\n\n    .opener-vignette {\n\n      position: absolute;\n\n      inset: 0;\n\n      background:\n        radial-gradient(\n          ellipse at center,\n\n          transparent 42%,\n\n          rgba(0, 0, 0, 0.68) 100%\n        );\n\n      pointer-events: none;\n    }\n\n\n    /* =========================================================\n       START UI\n    ========================================================= */\n\n    #opener-content {\n\n      position: absolute;\n\n      inset: 0;\n\n      display: flex;\n\n      align-items: flex-end;\n\n      justify-content: center;\n\n      padding-bottom: 11vh;\n\n      pointer-events: none;\n    }\n\n\n    #cyberwrap-website {\n\n      appearance: none;\n      -webkit-appearance: none;\n\n      box-sizing: border-box;\n\n      border: 1px solid rgba(0, 255, 255, 0.75);\n\n      border-radius: 999px;\n\n      padding: 10px 14px;\n\n      background: rgba(0, 0, 0, 0.48);\n\n      color: #ffffff;\n\n      font-family: Arial, Helvetica, sans-serif;\n\n      font-size: 11px;\n\n      font-weight: 700;\n\n      letter-spacing: 0.08em;\n\n      text-align: center;\n\n      text-decoration: none;\n\n      text-shadow: 0 0 8px rgba(0, 255, 255, 0.75);\n\n      box-shadow:\n        0 0 10px rgba(0, 255, 255, 0.25),\n        inset 0 0 10px rgba(0, 255, 255, 0.06);\n\n      cursor: pointer;\n\n      pointer-events: auto;\n\n      touch-action: manipulation;\n\n      -webkit-tap-highlight-color: transparent;\n    }\n\n\n    #cyberwrap-website:active {\n\n      transform: scale(0.96);\n\n      background: rgba(0, 255, 255, 0.16);\n    }\n\n\n    #cyberwrap-website {\n\n      position: absolute;\n\n      top: max(20px, env(safe-area-inset-top));\n\n      right: max(16px, env(safe-area-inset-right));\n\n      margin: 0;\n\n      border-width: 2px;\n\n      padding: 11px 16px;\n\n      color: #74ffff;\n\n      font-size: 11px;\n    }\n\n\n    #cyberwrap-website {\n\n      border: 0;\n\n      background: #dc2626;\n\n      color: #ffffff;\n\n      text-shadow: none;\n\n      box-shadow: none;\n    }\n\n\n    #cyberwrap-website:active {\n\n      background: #b91c1c;\n    }\n\n\n    /* =========================================================\n   START AR BUTTON\n========================================================= */\n\n#cyberwrap-start-ar {\n\n  appearance: none;\n  -webkit-appearance: none;\n\n  border: 2px solid rgba(0, 255, 255, 0.9);\n\n  border-radius: 999px;\n\n  padding: 16px 34px;\n\n  min-width: 190px;\n\n  background:\n    rgba(0, 0, 0, 0.48);\n\n  color: #ffffff;\n\n  font-family:\n    Arial,\n    Helvetica,\n    sans-serif;\n\n  font-size:\n    clamp(17px, 5vw, 24px);\n\n  font-weight: 700;\n\n  letter-spacing:\n    0.14em;\n\n  text-align: center;\n\n  text-shadow:\n    0 0 8px rgba(0, 255, 255, 0.85),\n    0 0 18px rgba(0, 255, 255, 0.55);\n\n  box-shadow:\n    0 0 12px rgba(0, 255, 255, 0.35),\n    inset 0 0 12px rgba(0, 255, 255, 0.08);\n\n  cursor: pointer;\n\n  pointer-events: auto;\n\n  touch-action: manipulation;\n\n  -webkit-tap-highlight-color: transparent;\n\n  -webkit-user-select: none;\n  user-select: none;\n\n  animation:\n    cyberwrap-pulse 1.4s ease-in-out infinite;\n\n  transition:\n    transform 0.15s ease,\n    background 0.15s ease,\n    box-shadow 0.15s ease;\n}\n\n\n#cyberwrap-start-ar:active {\n\n  transform: scale(0.96);\n\n  background:\n    rgba(0, 255, 255, 0.16);\n\n  box-shadow:\n    0 0 20px rgba(0, 255, 255, 0.7),\n    inset 0 0 16px rgba(0, 255, 255, 0.15);\n}\n\n\n#cyberwrap-start-ar:disabled {\n\n  opacity: 0.65;\n\n  cursor: default;\n\n  animation: none;\n}\n\n    /* =========================================================\n       STARTING STATE\n    ========================================================= */\n\n    #cyberwrap-opener.starting #cyberwrap-start-ar {\n\n  animation: none;\n\n  opacity: 0.7;\n\n  letter-spacing: 0.08em;\n}\n\n\n    /* =========================================================\n       TAP PULSE\n    ========================================================= */\n\n    @keyframes cyberwrap-pulse {\n\n      0%,\n      100% {\n\n        opacity: 0.45;\n\n        transform: scale(0.98);\n      }\n\n      50% {\n\n        opacity: 1;\n\n        transform: scale(1);\n      }\n\n    }\n\n\n    /* =========================================================\n       DRIVEZONE PLACEMENT HINT\n    ========================================================= */\n\n    #cyberwrap-placement-hint {\n\n      position: fixed;\n\n      left: 50%;\n\n      bottom: 12%;\n\n      transform:\n        translateX(-50%);\n\n      z-index: 1000;\n\n      width: 90%;\n\n      text-align: center;\n\n      color: #ffffff;\n\n      font-family:\n        Arial,\n        Helvetica,\n        sans-serif;\n\n      font-size:\n        clamp(16px, 4vw, 26px);\n\n      font-weight: 700;\n\n      letter-spacing:\n        0.12em;\n\n      text-shadow:\n        0 0 8px rgba(0, 255, 255, 0.9),\n        0 0 18px rgba(0, 255, 255, 0.5);\n\n      pointer-events: none;\n\n      user-select: none;\n      -webkit-user-select: none;\n\n      opacity: 1;\n\n      visibility: visible;\n\n      animation:\n        placement-pulse 1.4s ease-in-out infinite;\n    }\n\n\n    /* =========================================================\n       HIDDEN PLACEMENT HINT\n    ========================================================= */\n\n    #cyberwrap-placement-hint.hidden {\n\n      opacity: 0;\n\n      visibility: hidden;\n\n      pointer-events: none;\n\n      animation: none;\n\n      transition:\n        opacity 0.25s ease,\n        visibility 0.25s ease;\n    }\n\n\n    /* =========================================================\n       PLACEMENT PULSE\n    ========================================================= */\n\n    @keyframes placement-pulse {\n\n      0%,\n      100% {\n\n        opacity: 0.55;\n      }\n\n      50% {\n\n        opacity: 1;\n      }\n\n    }\n\n\n    /* =========================================================\n       BOOT PROTECTION\n    ========================================================= */\n\n    body.cyberwrap-booting {\n\n      overflow: hidden;\n    }\n\n\n    /*\n     * Hide normal HTML controls while CyberWrap\n     * is still in its startup phase.\n     *\n     * The AR scene remains active underneath.\n     */\n\n    body.cyberwrap-booting button,\n    body.cyberwrap-booting [role=\"button\"],\n    body.cyberwrap-booting input,\n    body.cyberwrap-booting textarea,\n    body.cyberwrap-booting select {\n\n      visibility: hidden !important;\n\n      pointer-events: none !important;\n    }\n\nbody.cyberwrap-booting #cyberwrap-start-ar {\n\n  visibility: visible !important;\n\n  pointer-events: auto !important;\n}\n\n    /* =========================================================\n       MOBILE\n    ========================================================= */\n\n    @media (max-width: 600px) {\n\n      #opener-content {\n\n        padding-bottom: 10vh;\n      }\n\n      #cyberwrap-start-ar {\n\n      font-size:\n        clamp(17px, 5vw, 24px);\n\n      min-width: 180px;\n\n      padding:\n        15px 30px;\n\n      letter-spacing:\n        0.14em;\n    }\n\n      #cyberwrap-placement-hint {\n\n        bottom: 11%;\n\n        width: 92%;\n\n        font-size:\n          clamp(15px, 4.5vw, 22px);\n\n        letter-spacing:\n          0.10em;\n      }\n\n    }\n\n\n    /* =========================================================\n       VERY SMALL PHONES\n    ========================================================= */\n\n    @media (max-height: 600px) {\n\n      #opener-content {\n\n        padding-bottom: 7vh;\n      }\n\n      #opener-status {\n\n        font-size: 16px;\n      }\n\n      #cyberwrap-placement-hint {\n\n        bottom: 8%;\n      }\n\n    }\n\n\n    /* =========================================================\n       TABLETS\n    ========================================================= */\n\n    @media (min-width: 601px) {\n\n      #cyberwrap-start-ar {\n\n        font-size:\n          clamp(20px, 3vw, 30px);\n      }\n\n    }\n\n\n    /* =========================================================\n       LANDSCAPE\n    ========================================================= */\n\n    @media (orientation: landscape) {\n\n      #opener-content {\n\n        padding-bottom: 6vh;\n      }\n\n      #cyberwrap-start-ar {\n\n        font-size:\n          clamp(16px, 3vw, 24px);\n      }\n\n      #cyberwrap-placement-hint {\n\n        bottom: 8%;\n\n        font-size:\n          clamp(15px, 3vw, 22px);\n      }\n\n    }\n\n\n    /* =========================================================\n       REDUCED MOTION\n    ========================================================= */\n\n    @media (prefers-reduced-motion: reduce) {\n\n      .opener-image {\n\n        animation: none;\n\n        transform:\n          scale(1.04);\n      }\n\n      .opener-scanlines {\n\n        animation: none;\n      }\n\n      #cyberwrap-start-ar {\n\n      animation: none;\n\n      opacity: 1;\n      }\n\n      #cyberwrap-placement-hint {\n\n        animation: none;\n\n        opacity: 1;\n      }\n\n    }\n\n\n    /* =========================================================\n       SAFARI / IOS TOUCH\n    ========================================================= */\n\n    #cyberwrap-opener,\n    #cyberwrap-opener * {\n\n      box-sizing: border-box;\n    }\n\n\n    #cyberwrap-opener {\n\n      cursor: pointer;\n\n      touch-action: manipulation;\n\n      -webkit-touch-callout: none;\n\n      -webkit-tap-highlight-color: transparent;\n    }\n\n  </style>\n\n\n  <!-- =========================================================\n       PAGE METADATA\n  ========================================================= -->\n\n  <meta\n    itemprop=\"name\"\n    content=\"CyberWrap\"\n  >\n\n  <meta\n    name=\"twitter:title\"\n    content=\"CyberWrap\"\n  >\n\n  <meta\n    property=\"og:title\"\n    content=\"CyberWrap\"\n  >\n\n  <meta\n    property=\"og:site_name\"\n    content=\"CyberWrap\"\n  >\n\n  <meta\n    name=\"description\"\n    content=\"CyberWrap — an immersive WebAR delivery driving experience.\"\n  >\n\n  <meta\n    itemprop=\"description\"\n    content=\"CyberWrap — an immersive WebAR delivery driving experience.\"\n  >\n\n  <meta\n    property=\"og:description\"\n    content=\"CyberWrap — an immersive WebAR delivery driving experience.\"\n  >\n\n  <meta\n    name=\"twitter:description\"\n    content=\"CyberWrap — an immersive WebAR delivery driving experience.\"\n  >\n\n\n  <!-- =========================================================\n       8TH WALL RUNTIME\n  ========================================================= -->\n\n  <script\n    crossorigin=\"anonymous\"\n    src=\"/external/runtime/runtime.js\">\n  </script>\n\n\n  <script\n    src=\"https://cdn.jsdelivr.net/npm/@8thwall/engine-binary@1/dist/xr.js\"\n    async\n    crossorigin=\"anonymous\"\n    data-preload-chunks=\"slam\">\n  </script>\n\n\n  <script\n    src=\"https://cdn.jsdelivr.net/npm/@8thwall/landing-page@1/dist/landing-page.js\"\n    crossorigin=\"anonymous\">\n  </script>\n\n\n  <meta\n    property=\"og:image\"\n    content=\"https://8thwall.org/studio-world-effects-example/assets/preview.png\"\n  >\n\n</head>\n\n\n<!-- =========================================================\n     BODY\n========================================================= -->\n\n<body class=\"cyberwrap-booting\">\n\n\n  <!-- =========================================================\n       DRIVEZONE PLACEMENT INSTRUCTION\n\n       This is intentionally NOT a button.\n\n       pointer-events: none means the user's tap passes\n       straight through to the AR / ECS touch system.\n  ========================================================= -->\n\n\n\n  <!-- =========================================================\n       CYBERWRAP START OPENER\n\n       There must be ONLY ONE element with this ID.\n  ========================================================= -->\n\n  <div id=\"cyberwrap-opener\">\n\n    <!-- Main artwork -->\n\n    <div class=\"opener-image\"></div>\n\n\n    <!-- Digital scanlines -->\n\n    <div class=\"opener-scanlines\"></div>\n\n\n    <!-- Cinematic vignette -->\n\n    <div class=\"opener-vignette\"></div>\n\n\n    <!-- Start message -->\n\n    <div id=\"opener-content\">\n\n    <a\n      id=\"cyberwrap-website\"\n      href=\"https://dailybreadshawarma.store\"\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      aria-label=\"Visit Daily Bread Shawarma website\"\n    >\n      ORDER ONLINE\n    </a>\n\n    <button\n      id=\"cyberwrap-start-ar\"\n      type=\"button\"\n      aria-label=\"Start CyberWrap AR\"\n    >\n      START AR\n    </button>\n\n</div>\n\n  </div>\n\n\n  <!-- =========================================================\n       CYBERWRAP APPLICATION\n  ========================================================= -->\n\n  <script src=\"bundle.js\"></script>\n\n\n</body>\n\n</html>"
        }
    ]
}